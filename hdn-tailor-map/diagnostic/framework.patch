diff --git a/src/main/HdnDiagnostic.h b/src/main/HdnDiagnostic.h
new file mode 100644
index 0000000..712fc24
--- /dev/null
+++ b/src/main/HdnDiagnostic.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <atomic>
+
+// Diagnostic only: no engine calls, hooks, assignments, or marker policy.
+namespace HdnDiagnostic
+{
+	inline std::atomic<unsigned> doorCalls{ 0 };
+	inline std::atomic<unsigned> targetCalls{ 0 };
+	inline std::atomic<unsigned> importCalls{ 0 };
+
+	inline bool Take(std::atomic<unsigned>& a_count, unsigned a_limit)
+	{
+		auto count = a_count.load(std::memory_order_relaxed);
+		while (count < a_limit) {
+			if (a_count.compare_exchange_weak(count, count + 1, std::memory_order_relaxed)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	inline void ResetDoors()
+	{
+		doorCalls.store(0, std::memory_order_relaxed);
+		targetCalls.store(0, std::memory_order_relaxed);
+	}
+}

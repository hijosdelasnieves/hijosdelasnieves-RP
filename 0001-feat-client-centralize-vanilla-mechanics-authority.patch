+export const HDN_VANILLA_AUTHORITY_POLICY_VERSION = 1;
+export const HDN_VANILLA_MENU_LEASE_DEFAULT_MS = 15_000;
+export const HDN_VANILLA_MENU_LEASE_MAX_MS = 60_000;
+
+export enum HdnVanillaMenuFlag {
+  Magic = 1 << 0,
+  Stats = 1 << 1,
+  Journal = 1 << 2,
+  Favorites = 1 << 3,
+  Crafting = 1 << 4,
+  Training = 1 << 5,
+  LevelUp = 1 << 6,
+  SleepWait = 1 << 7,
+}
+
+export const HDN_VANILLA_FAIL_CLOSED_MENU_MASK =
+  HdnVanillaMenuFlag.Magic |
+  HdnVanillaMenuFlag.Stats |
+  HdnVanillaMenuFlag.Journal |
+  HdnVanillaMenuFlag.Favorites |
+  HdnVanillaMenuFlag.Crafting |
+  HdnVanillaMenuFlag.Training |
+  HdnVanillaMenuFlag.LevelUp |
+  HdnVanillaMenuFlag.SleepWait;
+
+export const HDN_VANILLA_KNOWN_MENU_MASK =
+  HDN_VANILLA_FAIL_CLOSED_MENU_MASK;
+
+export interface HdnVanillaMenuPolicyState {
+  policyVersion: number;
+  mask: number;
+  queueHookInstalled: boolean;
+  inputFenceInstalled: boolean;
+  blockedShowCount: number;
+  blockedInputCount: number;
+  failClosedDefault: boolean;
+}
+
+const MENU_FLAGS: Readonly<Record<string, HdnVanillaMenuFlag>> = {
+  "MagicMenu": HdnVanillaMenuFlag.Magic,
+  "Magic Menu": HdnVanillaMenuFlag.Magic,
+  "StatsMenu": HdnVanillaMenuFlag.Stats,
+  "Stats Menu": HdnVanillaMenuFlag.Stats,
+  "Journal Menu": HdnVanillaMenuFlag.Journal,
+  "JournalMenu": HdnVanillaMenuFlag.Journal,
+  "FavoritesMenu": HdnVanillaMenuFlag.Favorites,
+  "Favorites Menu": HdnVanillaMenuFlag.Favorites,
+  "Crafting Menu": HdnVanillaMenuFlag.Crafting,
+  "CraftingMenu": HdnVanillaMenuFlag.Crafting,
+  "SmithingMenu": HdnVanillaMenuFlag.Crafting,
+  "TanningMenu": HdnVanillaMenuFlag.Crafting,
+  "Cooking Menu": HdnVanillaMenuFlag.Crafting,
+  "CookingMenu": HdnVanillaMenuFlag.Crafting,
+  "AlchemyMenu": HdnVanillaMenuFlag.Crafting,
+  "EnchantConstructMenu": HdnVanillaMenuFlag.Crafting,
+  "Training Menu": HdnVanillaMenuFlag.Training,
+  "TrainingMenu": HdnVanillaMenuFlag.Training,
+  "LevelUp Menu": HdnVanillaMenuFlag.LevelUp,
+  "LevelUpMenu": HdnVanillaMenuFlag.LevelUp,
+  "Sleep/Wait Menu": HdnVanillaMenuFlag.SleepWait,
+  "SleepWaitMenu": HdnVanillaMenuFlag.SleepWait,
+};
+
+export function hdnVanillaMenuFlagForName(name: unknown): number {
+  return typeof name === "string" ? (MENU_FLAGS[name] || 0) : 0;
+}
+
+export function isHdnVanillaMenuBlocked(
+  name: unknown,
+  mask = HDN_VANILLA_FAIL_CLOSED_MENU_MASK,
+): boolean {
+  const flag = hdnVanillaMenuFlagForName(name);
+  return flag !== 0 && (mask & flag) !== 0;
+}
+
+export function decodeHdnVanillaMenuPolicyState(
+  value: unknown,
+): HdnVanillaMenuPolicyState | null {
+  if (!value || typeof value !== "object") return null;
+  const candidate = value as Partial<HdnVanillaMenuPolicyState>;
+  if (!Number.isInteger(candidate.policyVersion) ||
+      !Number.isInteger(candidate.mask) ||
+      typeof candidate.queueHookInstalled !== "boolean" ||
+      typeof candidate.inputFenceInstalled !== "boolean" ||
+      typeof candidate.failClosedDefault !== "boolean" ||
+      typeof candidate.blockedShowCount !== "number" ||
+      typeof candidate.blockedInputCount !== "number") {
+    return null;
+  }
+  return {
+    policyVersion: Number(candidate.policyVersion),
+    mask: Number(candidate.mask) >>> 0,
+    queueHookInstalled: candidate.queueHookInstalled,
+    inputFenceInstalled: candidate.inputFenceInstalled,
+    blockedShowCount: Math.max(0, Number(candidate.blockedShowCount) || 0),
+    blockedInputCount: Math.max(0, Number(candidate.blockedInputCount) || 0),
+    failClosedDefault: candidate.failClosedDefault,
+  };
+}
+
+export function isHdnVanillaNativeBarrierHealthy(
+  state: HdnVanillaMenuPolicyState | null,
+  expectedMask = HDN_VANILLA_FAIL_CLOSED_MENU_MASK,
+): boolean {
+  return !!state &&
+    state.policyVersion === HDN_VANILLA_AUTHORITY_POLICY_VERSION &&
+    state.queueHookInstalled &&
+    state.inputFenceInstalled &&
+    state.failClosedDefault &&
+    (state.mask & HDN_VANILLA_KNOWN_MENU_MASK) ===
+      (expectedMask & HDN_VANILLA_KNOWN_MENU_MASK);
+}
+
+export interface HdnVanillaMenuLease {
+  readonly token: string;
+  readonly owner: string;
+  readonly allowedMask: number;
+  readonly expiresAt: number;
+}
+
+type LeaseListener = () => void;
+
+/**
+ * Short-lived capability registry for systems that intentionally reuse a
+ * vanilla menu. A lease can only subtract known bits from the fail-closed
+ * mask, expires automatically, and is cleared on load/disconnect by the
+ * authority service.
+ */
+export class HdnVanillaMenuLeaseRegistry {
+  private readonly leases = new Map<string, HdnVanillaMenuLease>();
+  private readonly listeners = new Set<LeaseListener>();
+  private sequence = 0;
+
+  constructor(private readonly now: () => number = () => Date.now()) {}
+
+  acquire(
+    owner: string,
+    allowedMask: number,
+    ttlMs = HDN_VANILLA_MENU_LEASE_DEFAULT_MS,
+  ): string {
+    const normalizedOwner = String(owner || "").trim();
+    if (!normalizedOwner || normalizedOwner.length > 64) {
+      throw new Error("vanilla menu lease owner must contain 1-64 characters");
+    }
+    const normalizedMask =
+      (Number(allowedMask) >>> 0) & HDN_VANILLA_KNOWN_MENU_MASK;
+    if (normalizedMask === 0) {
+      throw new Error("vanilla menu lease must allow a known menu bit");
+    }
+    const issuedAt = this.now();
+    const token = `${normalizedOwner}:${issuedAt}:${++this.sequence}`;
+    this.leases.set(token, {
+      token,
+      owner: normalizedOwner,
+      allowedMask: normalizedMask,
+      expiresAt: issuedAt + this.normalizeTtl(ttlMs),
+    });
+    this.notify();
+    return token;
+  }
+
+  renew(token: string, ttlMs = HDN_VANILLA_MENU_LEASE_DEFAULT_MS): boolean {
+    this.pruneExpired(this.now());
+    const current = this.leases.get(token);
+    if (!current) return false;
+    this.leases.set(token, {
+      ...current,
+      expiresAt: this.now() + this.normalizeTtl(ttlMs),
+    });
+    this.notify();
+    return true;
+  }
+
+  release(token: string): boolean {
+    const released = this.leases.delete(token);
+    if (released) this.notify();
+    return released;
+  }
+
+  clear(): void {
+    if (this.leases.size === 0) return;
+    this.leases.clear();
+    this.notify();
+  }
+
+  getAllowedMask(at = this.now()): number {
+    this.pruneExpired(at);
+    let allowedMask = 0;
+    this.leases.forEach((lease) => {
+      allowedMask |= lease.allowedMask;
+    });
+    return allowedMask & HDN_VANILLA_KNOWN_MENU_MASK;
+  }
+
+  getEffectiveBlockedMask(at = this.now()): number {
+    return HDN_VANILLA_FAIL_CLOSED_MENU_MASK & ~this.getAllowedMask(at);
+  }
+
+  snapshot(at = this.now()): ReadonlyArray<HdnVanillaMenuLease> {
+    this.pruneExpired(at);
+    return Array.from(this.leases.values()).sort((a, b) =>
+      a.expiresAt - b.expiresAt || a.token.localeCompare(b.token));
+  }
+
+  subscribe(listener: LeaseListener): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  private normalizeTtl(ttlMs: number): number {
+    const finite = Number.isFinite(ttlMs)
+      ? Math.floor(ttlMs)
+      : HDN_VANILLA_MENU_LEASE_DEFAULT_MS;
+    return Math.max(100, Math.min(HDN_VANILLA_MENU_LEASE_MAX_MS, finite));
+  }
+
+  private pruneExpired(at: number): void {
+    this.leases.forEach((lease, token) => {
+      if (lease.expiresAt <= at) this.leases.delete(token);
+    });
+  }
+
+  private notify(): void {
+    this.listeners.forEach((listener) => {
+      try { listener(); } catch (_) { /* authority keeps reconciling */ }
+    });
+  }
+}
+
+export const hdnVanillaMenuLeases = new HdnVanillaMenuLeaseRegistry();
+
+export interface HdnVanillaProgressionProjectionSnapshot {
+  readonly playerLevel: number | null;
+  readonly skillLevels: Readonly<Record<number, number>>;
+}
+
+/**
+ * Canonical local projection used by the reconciler. Server-owned progression
+ * systems update this store before applying their level/skill changes; random
+ * vanilla XP, books and scripts are repaired back to the stored values.
+ */
+export class HdnVanillaProgressionProjectionStore {
+  private playerLevel: number | null = null;
+  private readonly skillLevels = new Map<number, number>();
+
+  reset(): void {
+    this.playerLevel = null;
+    this.skillLevels.clear();
+  }
+
+  capturePlayerLevel(level: number): number {
+    if (this.playerLevel === null) this.playerLevel = this.validPlayerLevel(level);
+    return this.playerLevel;
+  }
+
+  captureSkillLevel(actorValue: number, level: number): number {
+    const id = this.validSkillActorValue(actorValue);
+    if (!this.skillLevels.has(id)) {
+      this.skillLevels.set(id, this.validSkillLevel(level));
+    }
+    return this.skillLevels.get(id)!;
+  }
+
+  setPlayerLevel(level: number): void {
+    this.playerLevel = this.validPlayerLevel(level);
+  }
+
+  setSkillLevel(actorValue: number, level: number): void {
+    this.skillLevels.set(
+      this.validSkillActorValue(actorValue),
+      this.validSkillLevel(level),
+    );
+  }
+
+  getPlayerLevel(): number | null {
+    return this.playerLevel;
+  }
+
+  getSkillLevel(actorValue: number): number | null {
+    return this.skillLevels.get(Number(actorValue)) ?? null;
+  }
+
+  snapshot(): HdnVanillaProgressionProjectionSnapshot {
+    const skillLevels: Record<number, number> = {};
+    this.skillLevels.forEach((level, actorValue) => {
+      skillLevels[actorValue] = level;
+    });
+    return { playerLevel: this.playerLevel, skillLevels };
+  }
+
+  private validPlayerLevel(level: number): number {
+    const value = Number(level);
+    if (!Number.isFinite(value) || value < 1 || value > 65_535) {
+      throw new Error("HDN projected player level is invalid");
+    }
+    return Math.floor(value);
+  }
+
+  private validSkillActorValue(actorValue: number): number {
+    const value = Number(actorValue);
+    if (!Number.isInteger(value) || value < 6 || value > 23) {
+      throw new Error("HDN projected skill actor value is invalid");
+    }
+    return value;
+  }
+
+  private validSkillLevel(level: number): number {
+    const value = Number(level);
+    if (!Number.isFinite(value) || value < 0 || value > 10_000) {
+      throw new Error("HDN projected skill level is invalid");
+    }
+    return value;
+  }
+}
+
+export const hdnVanillaProgressionProjection =
+  new HdnVanillaProgressionProjectionStore();

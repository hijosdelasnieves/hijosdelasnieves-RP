+/**
+ * Single client-side reconciler for native mechanics that HDN owns.
+ *
+ * The native UI queue gate is installed before this bundle starts. This
+ * service attests/reapplies that policy, freezes vanilla progression, and
+ * repairs drift caused by books, scripts, old saves or a late level event.
+ * It deliberately remains fail-closed across network disconnects.
+ */
+export class VanillaAuthorityService extends ClientListener {
+  private lastPolicyAt = 0;
+  private lastProgressionAt = 0;
+  private lastNativeStateLogAt = 0;
+  private nativeApiFailureReported = false;
+  private nativeBarrierFailureReported = false;
+  private progressionUrgent = true;
+
+  constructor(
+    private readonly sp: Sp,
+    private readonly controller: CombinedController,
+  ) {
+    super();
+
+    this.controller.on("update", () => this.onUpdate());
+    this.controller.on("skillIncrease", () => this.requestProgressionRepair());
+    this.controller.on("levelIncrease", (event) => {
+      this.requestProgressionRepair();
+      logError(this,
+        "vanilla level drift intercepted; HDN progression remains authoritative",
+        { newLevel: Number((event as any)?.newLevel) || 0 });
+    });
+    this.controller.emitter.on("gameLoad", () => this.onGameLoad());
+    this.controller.emitter.on("connectionAccepted",
+      () => this.resetAuthorityBoundary());
+    this.controller.emitter.on("connectionDisconnect",
+      () => this.resetAuthorityBoundary());
+    this.controller.emitter.on("connectionDenied",
+      () => this.resetAuthorityBoundary());
+    this.controller.emitter.on("connectionFailed",
+      () => this.resetAuthorityBoundary());

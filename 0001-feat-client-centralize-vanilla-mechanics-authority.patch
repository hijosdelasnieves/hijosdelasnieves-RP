+
+interface NativePolicyApi {
+  setHdnVanillaMenuPolicy?: (mask: number) => void;
+  getHdnVanillaMenuPolicyState?: () => unknown;
+  setHdnMagicMenuBlocked?: (blocked: boolean) => void;
+}

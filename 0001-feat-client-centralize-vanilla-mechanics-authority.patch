+    private directCloseMenu(menuName: string): void {
+        // MagicMenu no puede usar el cierre historico por ESC: cuando el
+        // cierre directo ya ha retirado magia, el ESC pendiente abre el menu
+        // de pausa. Repetimos Ui.closeMenu unas pocas actualizaciones sin
+        // generar ninguna otra entrada de teclado.
+        const MAX_FRAMES = 8;
+        let frames = 0;
+        const tick = () => {
+            frames++;
+            let stillOpen = false;
+            try { stillOpen = this.sp.Ui.isMenuOpen(menuName); } catch (_) { /* noop */ }
+            if (stillOpen) {
+                try {
+                    (this.sp.callNative as any)("TESModPlatform", "CloseMenu", undefined, menuName);
+                } catch (_) { /* noop */ }
+            }
+            if (stillOpen && frames < MAX_FRAMES) {
+                try { this.controller.once("update", tick); } catch (_) { /* noop */ }
+            }
+        };
+        try {
+            (this.sp.callNative as any)("TESModPlatform", "CloseMenu", undefined, menuName);
+            this.controller.once("update", tick);
+        } catch (error) {
+            logError(this, "directCloseMenu failed", error);
+        }
+    }

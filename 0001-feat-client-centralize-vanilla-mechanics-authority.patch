+          policyVersion: state?.policyVersion,
+          mask: state?.mask,
+          blockedShowCount: state?.blockedShowCount,
+          blockedInputCount: state?.blockedInputCount,
+          activeLeases: hdnVanillaMenuLeases.snapshot(now).length,
+        });
+      }

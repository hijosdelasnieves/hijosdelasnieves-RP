@@ -0,0 +1,115 @@
+import {
+  decodeHdnVanillaMenuPolicyState,
+  HDN_VANILLA_AUTHORITY_POLICY_VERSION,
+  HDN_VANILLA_FAIL_CLOSED_MENU_MASK,
+  HdnVanillaMenuLeaseRegistry,
+  HdnVanillaProgressionProjectionStore,
+  HdnVanillaMenuFlag,
+  hdnVanillaMenuFlagForName,
+  isHdnVanillaMenuBlocked,
+  isHdnVanillaNativeBarrierHealthy,
+} from "./vanillaAuthorityPolicy";
+
+declare const require: { main?: unknown } | undefined;
+declare const module: unknown;
+
+function assert(condition: boolean, message: string): void {
+  if (!condition) throw new Error(message);
+}
+
+export function runVanillaAuthorityPolicyTests(): void {
+  assert(hdnVanillaMenuFlagForName("MagicMenu") === HdnVanillaMenuFlag.Magic,
+    "MagicMenu must map to the native magic bit");
+  assert(hdnVanillaMenuFlagForName("Journal Menu") === HdnVanillaMenuFlag.Journal,
+    "the real Skyrim Journal Menu name must be covered");
+  assert(hdnVanillaMenuFlagForName("Crafting Menu") === HdnVanillaMenuFlag.Crafting,
+    "the real Skyrim Crafting Menu name must be covered");
+  assert(hdnVanillaMenuFlagForName("InventoryMenu") === 0,
+    "inventory remains outside the managed deny policy");
+
+  for (const name of [
+    "MagicMenu",
+    "StatsMenu",
+    "Journal Menu",
+    "FavoritesMenu",
+    "Crafting Menu",
+    "Training Menu",
+    "LevelUp Menu",
+    "Sleep/Wait Menu",
+  ]) {
+    assert(isHdnVanillaMenuBlocked(name),
+      `${name} must fail closed in the HDN runtime`);
+  }
+
+  const healthy = decodeHdnVanillaMenuPolicyState({
+    policyVersion: HDN_VANILLA_AUTHORITY_POLICY_VERSION,
+    mask: HDN_VANILLA_FAIL_CLOSED_MENU_MASK,
+    queueHookInstalled: true,
+    inputFenceInstalled: true,
+    blockedShowCount: 2,
+    blockedInputCount: 3,
+    failClosedDefault: true,
+  });
+  assert(isHdnVanillaNativeBarrierHealthy(healthy),
+    "a complete pre-show and input barrier must attest healthy");
+  assert(!isHdnVanillaNativeBarrierHealthy(
+    healthy && { ...healthy, queueHookInstalled: false }),
+  "a reactive-only runtime must never attest healthy");
+  assert(!isHdnVanillaNativeBarrierHealthy(
+    healthy && { ...healthy, mask: HdnVanillaMenuFlag.Magic }),
+  "a partial menu mask must never attest as the complete authority policy");
+  assert(isHdnVanillaNativeBarrierHealthy(
+    healthy && {
+      ...healthy,
+      mask: HDN_VANILLA_FAIL_CLOSED_MENU_MASK & ~HdnVanillaMenuFlag.Crafting,
+    },
+    HDN_VANILLA_FAIL_CLOSED_MENU_MASK & ~HdnVanillaMenuFlag.Crafting,
+  ), "an exact controlled reuse mask must attest healthy");
+  assert(decodeHdnVanillaMenuPolicyState({ mask: 1 }) === null,
+    "malformed native state must fail closed");
+
+  let now = 1_000;
+  const leases = new HdnVanillaMenuLeaseRegistry(() => now);
+  const crafting = leases.acquire(
+    "artisan",
+    HdnVanillaMenuFlag.Crafting,
+    500,
+  );
+  assert(
+    leases.getEffectiveBlockedMask() ===
+      (HDN_VANILLA_FAIL_CLOSED_MENU_MASK & ~HdnVanillaMenuFlag.Crafting),
+    "a lease must only open its declared menu bit",
+  );
+  assert(leases.renew(crafting, 600), "an active lease must renew");
+  now += 599;
+  assert(leases.snapshot().length === 1, "a renewed lease must stay active");
+  now += 1;
+  assert(leases.snapshot().length === 0, "a lease must expire fail-closed");
+
+  const magic = leases.acquire("academy", HdnVanillaMenuFlag.Magic);
+  assert(leases.release(magic), "the owner must be able to release its lease");
+  assert(
+    leases.getEffectiveBlockedMask() === HDN_VANILLA_FAIL_CLOSED_MENU_MASK,
+    "release must immediately restore the full deny mask",
+  );
+
+  const progression = new HdnVanillaProgressionProjectionStore();
+  assert(progression.capturePlayerLevel(12) === 12,
+    "the initial local player level must be captured");
+  assert(progression.capturePlayerLevel(13) === 12,
+    "vanilla drift must not replace the canonical player level");
+  progression.setPlayerLevel(14);
+  assert(progression.getPlayerLevel() === 14,
+    "an HDN system must be able to replace the projected player level");
+  progression.captureSkillLevel(18, 25);
+  progression.captureSkillLevel(18, 26);
+  assert(progression.getSkillLevel(18) === 25,
+    "skill drift must not replace the captured projection");
+  progression.setSkillLevel(18, 30);
+  assert(progression.snapshot().skillLevels[18] === 30,
+    "an HDN system must be able to replace a projected skill level");
+}
+
+if (typeof require !== "undefined" && require.main === module) {
+  runVanillaAuthorityPolicyTests();
+}
